# PORT: Port where the unified Express SSR & API server listens (default: 3000)
PORT=3000

# APP_URL: The URL where this platform is hosted.
APP_URL="http://localhost:3000"

# Optional Live PSP / Acquirer Credentials (Server-side only — when absent, /api/payments operates in sandbox/simulation mode)
STRIPE_SECRET_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""

# Experimental PostgreSQL/Drizzle scaffold. No active business route uses this connection.
# For manual Drizzle CLI work, connect through Cloud SQL Auth Proxy or another trusted endpoint.
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
