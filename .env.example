# PORT: Port where the unified Express SSR & API server listens (default: 3000)
PORT=3000

# APP_URL: The URL where this platform is hosted.
APP_URL="http://localhost:3000"

# Optional Live PSP / Acquirer Credentials (Server-side only — when absent, /api/payments operates in sandbox/simulation mode)
STRIPE_SECRET_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
