        },
        "tableNumber": {
          "type": "number",
          "description": "Assigned floor table number"
        },
        "date": {
          "type": "string",
          "description": "Reservation date YYYY-MM-DD",
          "maxLength": 16
        },
        "time": {
          "type": "string",
          "description": "Reservation time HH:mm",
          "maxLength": 16
