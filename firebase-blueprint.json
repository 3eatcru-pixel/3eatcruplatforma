        },
        "createdByUid": {
          "type": "string",
          "description": "Initiating user UID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "orderId", "tenantId", "amount", "method", "status", "environment", "createdByUid", "createdAt"]
    },
    "Reservation": {
      "title": "Reservation",
