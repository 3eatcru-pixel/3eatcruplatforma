        },
        "staffUids": {
          "type": "array",
          "description": "Authorized store staff UIDs for query-enforced reads"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "tenantId", "customerName", "date", "time", "status", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Verified Super Admin registry for HQ Central"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Write-locked RBAC profile mapping UID to non-HQ role and tenantId"
    },
    "/tenants/{tenantId}": {
      "schema": "Tenant",
      "description": "Private enterprise configuration for Store OS and HQ"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Private ERP catalog with costPrice, supplier, and exact stock"
    },
    "/public_catalog/{productId}": {
      "schema": "PublicProduct",
      "description": "Sanitized public Marketplace product catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Unified omnichannel commercial orders"
    },
    "/tables/{tableId}": {
      "schema": "Table",
      "description": "Restaurant floor tables scoped by tenantId and staffUids"
    },
    "/financials/{finId}": {
      "schema": "FinancialRecord",
      "description": "Authoritative tenant financial ledger"
    },
    "/delivery_routes/{routeId}": {
      "schema": "DeliveryRoute",
      "description": "Delivery route batches scoped by staffUids and driverId"
    },
