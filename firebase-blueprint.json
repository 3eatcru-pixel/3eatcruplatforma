        "id": {
          "type": "string",
          "description": "Route ID",
          "maxLength": 64
        },
        "tenantId": {
          "type": "string",
          "description": "Associated tenant ID",
          "maxLength": 64
        },
        "driverId": {
          "type": "string",
          "description": "Assigned driver UID",
          "maxLength": 128
        },
        "staffUids": {
          "type": "array",
          "description": "Bounded list (<= 20) of store staff UIDs"
        },
        "status": {
          "type": "string",
          "description": "Route status",
          "enum": ["available", "accepted", "at_store", "in_progress", "completed"]
