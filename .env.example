# PORT: Port where the unified Express SSR & API server listens (default: 3000)
PORT=3000

# APP_URL: The URL where this platform is hosted.
APP_URL="http://localhost:3000"

# Server-side platform billing credentials. Each provider needs its API credential and webhook secret.
# Configure Stripe events: checkout.session.completed, checkout.session.expired, invoice.paid,
# invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted.
STRIPE_SECRET_KEY=""
STRIPE_BILLING_WEBHOOK_SECRET=""
# Configure Mercado Pago topics: subscription_preapproval and subscription_authorized_payment.
# The payment topic is also accepted as a compatibility fallback.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# These global credentials are used only for the platform's SaaS billing. They do not authorize
# charging marketplace orders to the HQ account; store order payments remain store-owned.

# Experimental PostgreSQL/Drizzle scaffold. No active business route uses this connection.
# For manual Drizzle CLI work, connect through Cloud SQL Auth Proxy or another trusted endpoint.
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
