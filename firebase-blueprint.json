          "type": "string",
          "description": "Driver full name",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Driver phone",
          "maxLength": 32
        },
        "vehicleType": {
          "type": "string",
          "description": "Vehicle used",
          "enum": ["moto", "bike", "car", "van"]
        },
        "status": {
          "type": "string",
          "description": "Availability state",
          "enum": ["available", "delivering", "offline"]
        }
      },
      "required": ["id", "tenantId", "name", "vehicleType", "status"]
    },
    "HqSetting": {
      "title": "HqSetting",
      "description": "Private HQ Central global governance configuration (commission, maintenance, broadcast)",
      "type": "object",
      "properties": {
        "maintenanceMode": {
          "type": "boolean",
          "description": "Global maintenance lock"
        },
        "globalBroadcastMessage": {
          "type": "string",
          "description": "System broadcast message",
          "maxLength": 500
        },
        "platformCommissionRate": {
          "type": "number",
          "description": "SaaS platform commission split"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO update timestamp",
          "maxLength": 64
        }
      },
      "required": ["maintenanceMode", "platformCommissionRate", "updatedAt"]
    },
    "PublicRegional": {
      "title": "PublicRegional",
      "description": "Public Marketplace regional hero and discovery settings",
