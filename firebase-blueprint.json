          "type": "string",
          "description": "Consumer phone",
          "maxLength": 32
        }
      },
      "required": ["id", "name", "email"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Server-authoritative Universal Payment Proxy transaction record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Payment transaction ID",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderId": {
          "type": "string",
          "description": "Linked Order ID",
          "maxLength": 64
        },
        "tenantId": {
          "type": "string",
          "description": "Associated tenant ID",
          "maxLength": 64
        },
        "amount": {
          "type": "number",
          "description": "Gross payment amount"
        },
        "netAmount": {
          "type": "number",
          "description": "Net amount after gateway fees"
        },
        "method": {
          "type": "string",
          "description": "Payment gateway method",
          "enum": ["pix", "credit_card", "debit_card", "cash", "voucher"]
        },
        "status": {
          "type": "string",
          "description": "Authoritative transaction status",
