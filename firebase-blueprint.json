{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Platform Super Admin for HQ Central",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Verified admin email address",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "HQ role designation",
          "enum": ["hq_admin", "super_admin"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Server-controlled RBAC user mapping (write-locked against client self-escalation)",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Display name",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Non-HQ application role",
          "enum": ["tenant_owner", "operator", "waiter", "driver", "consumer"]
        },
        "tenantId": {
          "type": "string",
          "description": "Bound tenant ID for store staff",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO update timestamp",
          "maxLength": 64
        }
      },
      "required": ["uid", "role"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Registered store enterprise operating in the 3eatcru platform",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Tenant unique identifier",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Commercial store name",
          "maxLength": 120
        },
        "legalName": {
          "type": "string",
          "description": "Corporate entity legal name",
          "maxLength": 140
        },
        "cnpj": {
          "type": "string",
          "description": "Tax identification CNPJ",
          "maxLength": 24
        },
        "category": {
          "type": "string",
          "description": "Business niche category",
          "enum": [
            "restaurant",
            "retail",
            "services",
            "hybrid",
            "health",
            "education",
            "automotive",
            "beauty",
            "petshop"
          ]
        },
        "plan": {
          "type": "string",
          "description": "SaaS subscription tier",
          "enum": ["Starter", "Professional", "Enterprise"]
        },
        "status": {
          "type": "string",
          "description": "Account status",
          "enum": ["active", "suspended", "trial"]
        },
        "ownerUid": {
          "type": "string",
          "description": "Primary Tenant Owner UID",
          "maxLength": 128
        },
        "staffUids": {
          "type": "array",
          "description": "Bounded list (<= 20) of authorized store staff UIDs"
        },
        "devicesLimit": {
          "type": "number",
          "description": "MDM device limit"
        },
        "contactEmail": {
          "type": "string",
          "description": "Store owner contact email",
          "maxLength": 128
        },
        "phone": {
          "type": "string",
          "description": "Store phone contact",
          "maxLength": 32
        },
        "deliveryRadiusKm": {
          "type": "number",
          "description": "Delivery range in kilometers"
        },
        "serviceFeePercent": {
          "type": "number",
          "description": "Platform commission percentage"
        },
        "isOpen": {
          "type": "boolean",
          "description": "Whether store is currently open"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "name", "cnpj", "plan", "status", "contactEmail"]
    },
    "Product": {
      "title": "Product",
      "description": "Private ERP catalog and inventory item managed by a tenant (contains cost, stock, supplier)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Product ID",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tenantId": {
          "type": "string",
          "description": "Parent tenant ID",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Product title",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Product category",
          "maxLength": 60
        },
        "price": {
          "type": "number",
          "description": "Selling price"
        },
        "costPrice": {
          "type": "number",
          "description": "Private wholesale acquisition cost"
        },
        "stock": {
          "type": "number",
          "description": "Exact physical stock"
        },
        "minStock": {
          "type": "number",
          "description": "Minimum stock alert threshold"
        },
        "barcode": {
          "type": "string",
          "description": "EAN / Barcode",
          "maxLength": 48
        },
        "sku": {
          "type": "string",
          "description": "Internal SKU",
          "maxLength": 48
        },
        "availableOnline": {
          "type": "boolean",
          "description": "Visible in public consumer catalog"
        },
        "description": {
          "type": "string",
          "description": "Item description",
          "maxLength": 400
        }
      },
      "required": ["id", "tenantId", "name", "price", "stock"]
    },
    "PublicProduct": {
      "title": "PublicProduct",
      "description": "Sanitized public Marketplace product projection free of cost, margin, supplier, and exact stock",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Product ID",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tenantId": {
          "type": "string",
          "description": "Parent tenant ID",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Public product title",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Product category",
          "maxLength": 60
        },
        "price": {
          "type": "number",
          "description": "Public selling price"
        },
        "image": {
          "type": "string",
          "description": "Product image URL",
          "maxLength": 500
        },
        "availableOnline": {
          "type": "boolean",
          "description": "Online availability flag"
        },
        "inStock": {
          "type": "boolean",
          "description": "Boolean stock availability without leaking internal quantity"
        },
        "description": {
          "type": "string",
          "description": "Public description",
          "maxLength": 400
        }
      },
      "required": ["id", "tenantId", "name", "category", "price", "availableOnline", "inStock"]
    },
    "Order": {
      "title": "Order",
      "description": "Unified omnichannel commercial order (POS, Waiter/Table, Storefront, Marketplace)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Order ID / Idempotency Key",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tenantId": {
          "type": "string",
          "description": "Tenant store ID",
          "maxLength": 64
        },
        "customerId": {
          "type": "string",
          "description": "Authenticated consumer UID",
          "maxLength": 128
        },
        "staffUids": {
          "type": "array",
          "description": "Bounded list (<= 20) of store staff UIDs authorized for realtime reads"
        },
        "orderNumber": {
          "type": "string",
          "description": "Human-readable order code",
          "maxLength": 32
        },
        "type": {
          "type": "string",
          "description": "Order modality",
          "enum": ["dine-in", "takeout", "delivery", "pos-counter"]
        },
        "customerName": {
          "type": "string",
          "description": "Consumer name",
          "maxLength": 100
        },
        "customerPhone": {
          "type": "string",
          "description": "Consumer contact phone",
          "maxLength": 32
        },
        "subtotal": {
          "type": "number",
          "description": "Authoritative catalog subtotal"
        },
        "deliveryFee": {
          "type": "number",
          "description": "Delivery fee"
        },
        "tax": {
          "type": "number",
          "description": "Service/tax amount"
        },
        "discount": {
          "type": "number",
          "description": "Authorized discount"
        },
        "total": {
          "type": "number",
          "description": "Grand total"
        },
        "status": {
          "type": "string",
          "description": "Canonical order workflow status",
          "enum": [
            "pending",
            "preparing",
            "ready",
            "dispatched",
            "completed",
            "cancelled",
            "delivered"
          ]
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment tender",
          "enum": ["cash", "card", "pix", "online"]
        },
        "paymentTransactionId": {
          "type": "string",
          "description": "Authoritative server payment transaction ID",
          "maxLength": 64
        },
        "paymentStatus": {
          "type": "string",
          "description": "Verified payment settlement state",
          "enum": ["pending", "pending_pix", "approved", "declined", "refunded"]
        },
        "driverId": {
          "type": "string",
          "description": "Assigned courier UID",
          "maxLength": 128
        },
        "channel": {
          "type": "string",
          "description": "Origination channel",
          "enum": [
            "POS",
            "Customer Storefront",
            "Table QR",
            "iFood",
            "WhatsApp",
            "Online Marketplace"
          ]
        },
        "items": {
          "type": "array",
          "description": "Bounded list of ordered items"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "tenantId",
        "orderNumber",
        "type",
        "total",
        "status",
        "paymentMethod",
        "createdAt"
      ]
    },
    "Table": {
      "title": "Table",
      "description": "Physical table in a restaurant floor plan",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Table ID",
          "maxLength": 64
        },
        "tenantId": {
          "type": "string",
          "description": "Tenant store ID",
          "maxLength": 64
        },
        "staffUids": {
          "type": "array",
          "description": "Bounded list (<= 20) of authorized store staff UIDs"
        },
        "number": {
          "type": "number",
          "description": "Table number"
        },
        "capacity": {
          "type": "number",
          "description": "Seating capacity"
        },
        "status": {
          "type": "string",
          "description": "Table status",
          "enum": ["available", "occupied", "billing", "reserved"]
        },
        "zone": {
          "type": "string",
          "description": "Table zone",
          "maxLength": 64
        }
      },
      "required": ["id", "tenantId", "number", "status"]
    },
    "FinancialRecord": {
      "title": "FinancialRecord",
      "description": "Authoritative financial ledger entry (sales, expenses, reversals)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Record ID (`fin-sale-*`, `fin-rev-*`, or `fin-*`)",
          "maxLength": 64
        },
        "tenantId": {
          "type": "string",
          "description": "Tenant store ID",
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "description": "Transaction type",
          "enum": ["income", "expense", "sale", "payout", "commission"]
        },
        "category": {
          "type": "string",
          "description": "Financial category",
          "maxLength": 64
        },
        "amount": {
          "type": "number",
          "description": "Transaction amount"
        },
        "description": {
          "type": "string",
          "description": "Ledger memo",
          "maxLength": 200
        },
        "referenceId": {
          "type": "string",
          "description": "Linked Order ID or cash operation reference",
          "maxLength": 64
        },
        "date": {
          "type": "string",
          "description": "ISO date",
          "maxLength": 64
        }
      },
      "required": ["id", "tenantId", "type", "amount", "date"]
    },
    "DeliveryRoute": {
      "title": "DeliveryRoute",
