      "properties": {
        "heroTitle": {
          "type": "string",
          "description": "Public marketplace headline",
          "maxLength": 160
        },
        "activeRegionName": {
          "type": "string",
          "description": "Active commercial region",
          "maxLength": 100
        }
      },
      "required": ["heroTitle", "activeRegionName"]
    },
    "Plan": {
      "title": "Plan",
      "description": "SaaS subscription plan tier",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Plan tier ID",
          "enum": ["Starter", "Professional", "Enterprise"]
        },
        "name": {
          "type": "string",
          "description": "Plan display name",
          "maxLength": 80
        },
        "priceMonthly": {
          "type": "number",
          "description": "Monthly subscription price"
        },
        "maxDevices": {
          "type": "number",
          "description": "Maximum paired POS terminals"
        }
      },
      "required": ["id", "name", "priceMonthly", "maxDevices"]
    },
    "Device": {
