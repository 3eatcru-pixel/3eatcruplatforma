        "id": {
          "type": "string",
          "description": "Device ID",
          "maxLength": 64
        },
        "tenantId": {
          "type": "string",
          "description": "Assigned tenant ID",
          "maxLength": 64
        },
        "deviceName": {
          "type": "string",
          "description": "Terminal label",
          "maxLength": 100
        },
        "serialNumber": {
          "type": "string",
          "description": "Hardware serial number",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "MDM status",
          "enum": ["online", "offline", "locked", "updating"]
        }
      },
      "required": ["id", "tenantId", "deviceName", "serialNumber", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable HQ governance and security audit trail",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Audit log ID",
          "maxLength": 64
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 64
        },
        "user": {
          "type": "string",
          "description": "Actor identifier",
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "description": "Action summary",
          "maxLength": 120
        },
        "severity": {
          "type": "string",
          "description": "Audit severity",
          "enum": ["info", "warning", "critical"]
        }
      },
      "required": ["id", "timestamp", "action", "severity"]
    },
    "Consumer": {
      "title": "Consumer",
      "description": "Marketplace consumer private profile",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Consumer UID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Consumer name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Consumer email",
          "maxLength": 128
        },
